.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #F5F7FA;
}

.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.theme-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.theme-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.theme-item {
  padding: 16rpx 24rpx;
  background: #F5F7FA;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
}
