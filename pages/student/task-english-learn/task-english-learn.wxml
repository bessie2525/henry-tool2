<view class="container">
  <view class="progress-bar">
    <text class="progress-text">{{currentIndex + 1}}/{{words.length}}</text>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{((currentIndex + 1)/words.length)*100}}%"></view>
    </view>
  </view>

  <view class="word-card">
    <text class="word-text">{{words[currentIndex].word}}</text>
    <text class="word-phonetic">{{words[currentIndex].phonetic}}</text>
    <button class="audio-btn" bindtap="onPlayAudio">🔊</button>
    <text class="word-meaning">{{words[currentIndex].meaning}}</text>
    <text class="word-example">{{words[currentIndex].example}}</text>
  </view>

  <view class="nav-buttons">
    <button class="nav-btn prev" bindtap="onPrev" disabled="{{currentIndex === 0}}">上一个</button>
    <button class="nav-btn next" bindtap="onNext" disabled="{{currentIndex === words.length - 1}}">下一个</button>
  </view>

  <button class="start-btn {{unlocked ? 'unlocked' : ''}}" bindtap="onStartGame" disabled="{{!unlocked}}">
    {{unlocked ? '开始冒险！' : '请先浏览完所有单词'}}
  </button>
</view>
