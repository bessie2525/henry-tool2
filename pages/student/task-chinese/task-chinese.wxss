.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #F5F7FA;
}

.theme-card {
  background: linear-gradient(135deg, #50E3C2 0%, #4A90E2 100%);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.2);
}

.theme-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.theme-text {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.editor-area {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.editor {
  width: 100%;
  min-height: 300rpx;
  font-size: 30rpx;
  line-height: 1.8;
}

.editor-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.voice-btn {
  background: #F5F7FA;
  color: #4A90E2;
  border: none;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.char-count {
  font-size: 24rpx;
  color: #999;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #50E3C2 0%, #4A90E2 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.history-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-tip {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 40rpx 0;
}
