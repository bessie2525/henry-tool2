<view class="container">
  <view class="progress">
    <view class="step {{step >= 1 ? 'active' : ''}}">
      <text class="step-num">1</text>
      <text class="step-text">选择物种</text>
    </view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step {{step >= 2 ? 'active' : ''}}">
      <text class="step-num">2</text>
      <text class="step-text">起名字</text>
    </view>
    <view class="step-line {{step >= 3 ? 'active' : ''}}"></view>
    <view class="step {{step >= 3 ? 'active' : ''}}">
      <text class="step-num">3</text>
      <text class="step-text">选择颜色</text>
    </view>
  </view>

  <view class="content">
    <view wx:if="{{step === 1}}" class="step-content">
      <text class="title">选择你的宠物</text>
      <view class="species-list">
        <view 
          wx:for="{{speciesList}}" 
          wx:key="id"
          class="species-card {{selectedSpecies && selectedSpecies.id === item.id ? 'selected' : ''}}"
          bindtap="onSelectSpecies"
          data-species="{{item}}"
        >
          <text class="species-emoji">{{item.emoji}}</text>
          <text class="species-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{step === 2}}" class="step-content">
      <text class="title">给宠物起个名字</text>
      <view class="pet-preview">
        <text class="preview-emoji" style="color: {{selectedColor}}">{{selectedSpecies && selectedSpecies.emoji}}</text>
      </view>
      <input 
        class="name-input" 
        placeholder="请输入2-6个字符"
        value="{{petName}}"
        bindinput="onPetNameInput"
        maxlength="6"
      />
    </view>

    <view wx:if="{{step === 3}}" class="step-content">
      <text class="title">选择颜色</text>
      <view class="pet-preview">
        <text class="preview-emoji" style="color: {{selectedColor}}">{{selectedSpecies && selectedSpecies.emoji}}</text>
        <text class="pet-name-display">{{petName}}</text>
      </view>
      <view class="color-list">
        <view 
          wx:for="{{colors}}" 
          wx:key="*this"
          class="color-item {{selectedColor === item ? 'selected' : ''}}"
          style="background-color: {{item}}"
          bindtap="onSelectColor"
          data-color="{{item}}"
        ></view>
      </view>
    </view>
  </view>

  <view class="footer">
    <button 
      wx:if="{{step > 1}}" 
      class="btn-secondary"
      bindtap="goPrev"
    >
      上一步
    </button>
    <button 
      wx:if="{{step < 3}}" 
      class="btn-primary"
      bindtap="goNext"
    >
      下一步
    </button>
    <button 
      wx:if="{{step === 3}}" 
      class="btn-primary"
      bindtap="onSubmit"
      loading="{{loading}}"
    >
      完成创建
    </button>
  </view>
</view>
