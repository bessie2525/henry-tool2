<view class="container">
  <scroll-view class="category-bar" scroll-x>
    <view 
      wx:for="{{categories}}" 
      wx:key="id"
      class="category-item {{selectedCategory === item.id ? 'active' : ''}}"
      bindtap="onCategoryTap"
      data-category="{{item}}"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <view class="achievement-list">
    <view 
      wx:for="{{achievements}}" 
      wx:key="id"
      wx:if="{{selectedCategory === 'all' || selectedCategory === item.category}}"
      class="achievement-card {{item.unlocked ? 'unlocked' : ''}}"
      bindtap="onClaimTap"
      data-achievement="{{item}}"
    >
      <view class="achievement-icon">
        <text class="icon-emoji">{{item.icon}}</text>
      </view>
      <view class="achievement-info">
        <text class="achievement-name">{{item.name}}</text>
        <text class="achievement-desc">{{item.description}}</text>
        <view wx:if="{{!item.unlocked && item.progress !== undefined}}" class="achievement-progress">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{(item.progress/item.total)*100}}%"></view>
          </view>
          <text class="progress-text">{{item.progress}}/{{item.total}}</text>
        </view>
      </view>
      <view class="achievement-reward">
        <text wx:if="{{!item.claimed && item.unlocked}}" class="claim-btn">领取</text>
        <text wx:elif="{{item.claimed}}" class="claimed-text">已领取</text>
        <text wx:else class="reward-text">🪙 {{item.reward.coins}}</text>
      </view>
    </view>
  </view>
</view>
