.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #F5F7FA;
}

.menu-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #CCC;
}

.switch-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.logout-btn {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  font-size: 30rpx;
  color: #FF6B6B;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
