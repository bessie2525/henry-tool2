.container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  display: block;
}

.existing-roles {
  margin-bottom: 60rpx;
}

.register-section {
  margin-bottom: 40rpx;
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.role-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.role-card.disabled {
  opacity: 0.5;
}

.role-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.role-desc {
  font-size: 24rpx;
  color: #999;
}

.registered-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.footer {
  margin-top: 40rpx;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
}
