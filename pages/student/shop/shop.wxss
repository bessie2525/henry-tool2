.container {
  min-height: 100vh;
  background: #F5F7FA;
}

.category-bar {
  white-space: nowrap;
  padding: 20rpx 30rpx;
  background: #fff;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-right: 20rpx;
  border-radius: 16rpx;
  background: #F5F7FA;
}

.category-item.active {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
}

.category-item .cat-emoji {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.category-item .cat-name {
  font-size: 24rpx;
  color: #666;
}

.category-item.active .cat-name {
  color: #fff;
}

.daily-recommend {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.recommend-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.recommend-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.recommend-tag {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.recommend-list {
  display: flex;
  gap: 20rpx;
}

.recommend-item {
  flex: 1;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.recommend-item .item-emoji {
  font-size: 50rpx;
  margin-bottom: 12rpx;
}

.recommend-item .item-name {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.recommend-item .item-price {
  font-size: 22rpx;
  color: #F5A623;
  font-weight: bold;
}

.shop-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 0 30rpx 30rpx;
}

.shop-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.shop-item .item-emoji {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.shop-item .item-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.item-price-tag {
  display: flex;
  align-items: center;
  background: #FFF9E6;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}

.item-price-tag .price-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.item-price-tag .price-num {
  font-size: 24rpx;
  color: #F5A623;
  font-weight: bold;
}
