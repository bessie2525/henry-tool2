page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #F5F7FA;
  color: #333333;
}

.container {
  padding: 20px;
}

button {
  border-radius: 12px;
  font-weight: 500;
}

.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
}

.btn-success {
  background-color: #50E3C2;
  color: #FFFFFF;
}

.btn-warning {
  background-color: #FFD700;
  color: #333333;
}

.text-primary {
  color: #4A90E2;
}

.text-success {
  color: #50E3C2;
}

.text-warning {
  color: #FFD700;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

