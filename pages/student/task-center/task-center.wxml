<view class="container">
  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <view wx:else class="content">
    <view class="progress-card">
      <text class="progress-title">今日任务</text>
    </view>

    <view wx:if="{{tasks.length === 0}}" class="empty-container">
      <text>暂无任务</text>
    </view>

    <view wx:else class="task-list">
      <view 
        wx:for="{{tasks}}" 
        wx:key="id"
        class="task-card {{item.status}}"
        bindtap="onTaskTap"
        data-task="{{item}}"
      >
        <text class="task-icon">{{item.icon}}</text>
        <view class="task-info">
          <text class="task-name">{{item.name}}</text>
          <text class="task-desc">{{item.description}}</text>
          <text class="task-status">{{item.status === 'approved' ? '已完成' : item.status === 'submitted' ? '待审核' : '未完成'}}</text>
        </view>
        <view class="task-reward">
          <text class="reward-icon">🪙</text>
          <text class="reward-num">+{{item.reward}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
