.status-bar {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
}

.status-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.status-item:last-child {
  margin-bottom: 0;
}

.status-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
}

.progress-bar {
  flex: 1;
  height: 20rpx;
  background: #F0F0F0;
  border-radius: 10rpx;
  margin: 0 20rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s;
}

.progress-fill.hunger {
  background: linear-gradient(90deg, #FF6B6B 0%, #FF8E53 100%);
}

.progress-fill.thirst {
  background: linear-gradient(90deg, #4A90E2 0%, #74B9FF 100%);
}

.progress-fill.mood {
  background: linear-gradient(90deg, #50E3C2 0%, #7ED321 100%);
}

.status-value {
  width: 80rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
