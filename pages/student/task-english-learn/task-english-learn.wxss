.container {
  min-height: 100vh;
  padding: 30rpx;
  background: linear-gradient(180deg, #E8F4FD 0%, #F5F7FA 100%);
}

.progress-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #666;
  width: 100rpx;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.word-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.word-text {
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.word-phonetic {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.audio-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  border: none;
  font-size: 36rpx;
  margin-bottom: 24rpx;
}

.word-meaning {
  font-size: 40rpx;
  font-weight: 500;
  color: #4A90E2;
  margin-bottom: 20rpx;
}

.word-example {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
  text-align: center;
}

.nav-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.nav-btn[disabled] {
  opacity: 0.3;
}

.start-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: #E0E0E0;
  color: #999;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.start-btn.unlocked {
  background: linear-gradient(135deg, #50E3C2 0%, #4A90E2 100%);
  color: #fff;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}
