.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #F5F7FA;
  display: flex;
  flex-direction: column;
}

.loading-container,
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.content-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 30rpx;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.type-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.student-info {
  margin-bottom: 20rpx;
}

.student-label {
  font-size: 26rpx;
  color: #999;
}

.student-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.content-section {
  margin-bottom: 20rpx;
}

.section-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.content-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.time-info {
  margin-bottom: 20rpx;
}

.time-label {
  font-size: 26rpx;
  color: #999;
}

.time-text {
  font-size: 26rpx;
  color: #666;
}

.status-badge {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.status-badge.pending {
  background: #FFF9E6;
  color: #F5A623;
}

.status-badge.approved {
  background: #E8FDF5;
  color: #50E3C2;
}

.status-badge.rejected {
  background: #FFF0F0;
  color: #FF6B6B;
}

.reward-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.reward-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.reward-item:last-child {
  margin-bottom: 0;
}

.reward-label {
  font-size: 28rpx;
  color: #666;
  width: 140rpx;
}

.reward-input {
  flex: 1;
  height: 72rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.reward-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 12rpx;
  width: 40rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.action-btn[disabled] {
  opacity: 0.6;
}

.action-btn.reject {
  background: #FFF0F0;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
}

.action-btn.approve {
  background: linear-gradient(135deg, #50E3C2 0%, #4A90E2 100%);
  color: #fff;
}
