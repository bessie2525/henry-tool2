<view class="container" wx:if="{{!loading}}">
  <view class="progress-bar">
    <text class="progress-text">{{currentIndex + 1}}/{{words.length}}</text>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
  </view>

  <view class="word-card" wx:if="{{currentWord}}">
    <text class="word-text">{{currentWord.word}}</text>
    <text class="word-phonetic">{{currentWord.phonetic}}</text>
    <button class="audio-btn" bindtap="onPlayAudio">🔊</button>
    <text class="word-meaning">{{currentWord.meaning}}</text>
    <text class="word-example">{{currentWord.example}}</text>
  </view>

  <view class="word-card" wx:else>
    <text class="word-text">暂无单词</text>
    <text class="word-meaning">请家长先添加英语单词</text>
  </view>

  <view class="nav-buttons">
    <button class="nav-btn prev" bindtap="onPrev" disabled="{{currentIndex === 0}}">上一个</button>
    <button class="nav-btn next" bindtap="onNext" disabled="{{currentIndex === words.length - 1}}">下一个</button>
  </view>

  <button class="start-btn {{unlocked ? 'unlocked' : ''}}" bindtap="onStartGame" disabled="{{!unlocked}}">
    {{unlocked ? '开始冒险！' : '请先浏览完所有单词'}}
  </button>
</view>

<view class="container" wx:else>
  <text>加载中...</text>
</view>
