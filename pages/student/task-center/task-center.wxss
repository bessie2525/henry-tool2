.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #F5F7FA;
}

.progress-card {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

.progress-title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #50E3C2 0%, #7ED321 100%);
  border-radius: 8rpx;
  transition: width 0.5s;
}

.progress-text {
  color: #fff;
  font-size: 28rpx;
}

.bonus-hint {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  text-align: center;
}

.bonus-hint text {
  color: #fff;
  font-size: 26rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.task-card.approved {
  background: linear-gradient(135deg, #E8FDF5 0%, #D4F4E8 100%);
}

.task-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.task-info {
  flex: 1;
}

.task-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.task-status {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.task-card.approved .task-status {
  color: #50E3C2;
}

.task-reward {
  display: flex;
  align-items: center;
  background: #FFF9E6;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
}

.reward-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.reward-num {
  font-size: 26rpx;
  font-weight: bold;
  color: #F5A623;
}
