<view class="container">
  <view class="title">请选择你的身份</view>
  
  <view class="role-list">
    <view class="role-card" bindtap="onSelectStudent">
      <text class="role-emoji">🧒</text>
      <text class="role-name">我是学生</text>
      <text class="role-desc">养宠物，完成学习任务</text>
    </view>
    
    <view class="role-card" bindtap="onSelectParent">
      <text class="role-emoji">👨‍👩‍👧</text>
      <text class="role-name">我是家长</text>
      <text class="role-desc">管理任务，查看学习报告</text>
    </view>
  </view>
</view>
