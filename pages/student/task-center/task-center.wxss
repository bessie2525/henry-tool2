.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #F5F7FA;
}

.loading-container,
.empty-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.content {
  min-height: 100vh;
}

.progress-card {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

.progress-title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.task-card.approved {
  background: linear-gradient(135deg, #E8FDF5 0%, #D4F4E8 100%);
}

.task-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.task-info {
  flex: 1;
}

.task-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.task-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.task-status {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.task-card.approved .task-status {
  color: #50E3C2;
}

.task-reward {
  display: flex;
  align-items: center;
  background: #FFF9E6;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
}

.reward-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.reward-num {
  font-size: 26rpx;
  font-weight: bold;
  color: #F5A623;
}
