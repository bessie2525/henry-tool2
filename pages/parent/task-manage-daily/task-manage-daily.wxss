.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #F5F7FA;
}

.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.form-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.form-label {
  font-size: 24rpx;
  color: #666;
}

.form-input-small {
  width: 100%;
  height: 72rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
}

.task-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.task-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.task-status.enabled {
  background: #E8FDF5;
  color: #50E3C2;
}

.task-status.disabled {
  background: #F0F0F0;
  color: #999;
}

.task-desc {
  font-size: 24rpx;
  color: #666;
}

.task-rewards {
  display: flex;
  gap: 20rpx;
}

.reward {
  font-size: 24rpx;
  color: #999;
}

.task-actions {
  display: flex;
  align-items: center;
}

.delete-btn {
  font-size: 26rpx;
  color: #FF6B6B;
  padding: 12rpx 20rpx;
  background: #FFF0F0;
  border-radius: 12rpx;
}
