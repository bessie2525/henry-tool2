.container {
  min-height: 100vh;
  background: #F5F7FA;
  display: flex;
  flex-direction: column;
}

.pet-display {
  padding: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-emoji {
  font-size: 160rpx;
}

.category-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
}

.category-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 30rpx;
}

.category-item.active {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
}

.item-list {
  flex: 1;
  padding: 30rpx;
}

.empty-text {
  display: block;
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}
